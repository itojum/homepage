---
import { render } from "astro:content";
import BlogDetail from "@/components/pages/blog/BlogDetail.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { type BlogEntry, getDraftBlogEntries, getRelatedBlogs, toBlog } from "@/libs/blog";

export async function getStaticPaths() {
	const entries = await getDraftBlogEntries();
	return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props as { entry: BlogEntry };
const blog = toBlog(entry);
const { Content } = await render(entry);
const relatedBlogs = await getRelatedBlogs(blog);
---

<BaseLayout
  title={blog.title}
  description={blog.description}
  image={blog.eyecatch?.url}
  noIndex={true}
>
  <BlogDetail blog={blog} relatedBlogs={relatedBlogs} searchable={false}>
    <Content />
  </BlogDetail>
</BaseLayout>
