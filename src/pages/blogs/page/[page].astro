---
import BlogsPage from "@/components/pages/blogs/BlogsPage.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getBlogs } from "@/libs/blog";

const PER_PAGE = 10;

export async function getStaticPaths() {
	const PER_PAGE = 10;

	const allBlogs = await getBlogs();
	const totalPages = Math.ceil(allBlogs.length / PER_PAGE);
	return Array.from({ length: totalPages }, (_, i) => ({
		params: { page: String(i + 1) },
	}));
}

const pageParam = Astro.params.page ?? "1";
const currentPage = Number(pageParam);

if (!Number.isInteger(currentPage) || currentPage < 1) {
	throw new Error("Invalid page");
}

const allBlogs = await getBlogs();
const blogs = allBlogs.slice((currentPage - 1) * PER_PAGE, currentPage * PER_PAGE);
const totalPages = Math.ceil(allBlogs.length / PER_PAGE);
---

<BaseLayout
  title={`Blog - ${currentPage}ページ目`}
  description={`ブログ記事一覧の${currentPage}ページ目。`}
  path={`/blogs/page/${currentPage}`}
>
  <BlogsPage blogs={blogs} currentPage={currentPage} totalPages={totalPages} />
</BaseLayout>
