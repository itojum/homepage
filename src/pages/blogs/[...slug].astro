---
import { render } from "astro:content";
import BlogDetail from "@/components/pages/blog/BlogDetail.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { type BlogEntry, getPublishedBlogEntries, getRelatedBlogs, toBlog } from "@/libs/blog";

export async function getStaticPaths() {
	const entries = await getPublishedBlogEntries();
	return entries.map((entry) => ({
		params: { slug: entry.id },
		props: { entry },
	}));
}

const { entry } = Astro.props as { entry: BlogEntry };
const blog = toBlog(entry);
const { Content } = await render(entry);
const relatedBlogs = await getRelatedBlogs(blog);
---

<BaseLayout
  title={blog.title}
  description={blog.description}
  image={blog.eyecatch?.url}
  path={`/blogs/${blog.id}`}
>
  <BlogDetail blog={blog} relatedBlogs={relatedBlogs}>
    <Content />
  </BlogDetail>
</BaseLayout>
