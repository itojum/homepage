---
import BlogsPage from "@/components/pages/blogs/BlogsPage.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getBlogs } from "@/libs/blog";

const PER_PAGE = 10;
const currentPage = 1;

const allBlogs = await getBlogs();
const blogs = allBlogs.slice((currentPage - 1) * PER_PAGE, currentPage * PER_PAGE);
const totalPages = Math.ceil(allBlogs.length / PER_PAGE);
---

<BaseLayout
  title="Blog"
  description="itojum.dev のブログ記事一覧。技術メモや活動記録を掲載しています。"
  path="/blogs"
>
  <BlogsPage
    blogs={blogs}
    currentPage={currentPage}
    totalPages={totalPages}
    totalItems={allBlogs.length}
    perPage={PER_PAGE}
  />
</BaseLayout>
