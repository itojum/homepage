---
import { EMAIL_ADDRESS, X_URL } from "@/consts";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="Contact"
  description="X（@itojum1230）またはメールでのお問い合わせ。"
  path="/contact"
  noIndex={true}
>
  <section class="win">
    <h1 class="win-title">れんらく</h1>
    <p class="lead">ご用件のある方は、以下の X アカウントまたはメールアドレスからご連絡ください。</p>
    <dl class="table">
      <dt class="dot-label">X</dt>
      <dd>
        <a href={X_URL} target="_blank" rel="noopener noreferrer">@itojum1230</a>
      </dd>
      <dt class="dot-label">Email</dt>
      <dd>
        <a href={`mailto:${EMAIL_ADDRESS}`}>{EMAIL_ADDRESS}</a>
      </dd>
    </dl>
  </section>
</BaseLayout>

<style>
  .lead {
    margin-bottom: 14px;
  }

  .table {
    display: grid;
    grid-template-columns: 6em minmax(0, 1fr);
    gap: 6px 14px;
    margin: 0;
  }

  dt {
    color: var(--ink-2);
  }

  dd {
    margin: 0;
  }
</style>
