---
import HomePage from "@/components/pages/home/HomePage.astro";
import { LINKS, SITE_DESCRIPTION, SITE_TITLE } from "@/consts";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getListedBlogs } from "@/libs/blog";

const latestBlogs = (await getListedBlogs()).slice(0, 4);
---

<BaseLayout
  title={SITE_TITLE}
  description={SITE_DESCRIPTION}
  path="/"
>
  <HomePage latestBlogs={latestBlogs} links={LINKS} />
</BaseLayout>
