---
import { SITE_TITLE } from "@/consts";
import Search from "../Search.astro";
import SearchAction from "./SearchAction.astro";
import ThemeToggle from "./ThemeToggle.astro";

// "itojum.dev" の "." だけをブランド色にする
const [name, ...rest] = SITE_TITLE.split(".");
const domain = rest.join(".");
---

<header class="top">
  <a class="logo" href="/" aria-label={`${SITE_TITLE} ホーム`}>
    {name}{domain && <><b>.</b>{domain}</>}
  </a>
  <div class="actions">
    <SearchAction />
    <ThemeToggle />
  </div>
  <Search />
</header>

<style>
  .top {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 0 4px;
    font-family: var(--font-dot);
    font-size: 15px;
  }

  .logo {
    font-size: 20px;
    letter-spacing: 0.06em;
    color: var(--ink);
    border-bottom: 0;
    user-select: none;
  }

  .logo b {
    font-weight: 400;
    color: var(--main);
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-left: auto;
  }

  .actions :global(button) {
    font: inherit;
    color: var(--ink);
    background: none;
    border: 0;
    padding: 4px 6px;
    cursor: pointer;
  }

  .actions :global(button:hover) {
    color: var(--link);
  }
</style>
