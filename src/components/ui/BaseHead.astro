---
import "@/styles/global.css";
import SEO from "@/components/ui/SEO.astro";
import { SITE_TITLE } from "@/consts";
import type { ArticleMeta } from "@/types/seo";

interface Props {
	title?: string;
	description?: string;
	image?: string;
	imageAlt?: string;
	path?: string;
	noIndex?: boolean;
	article?: ArticleMeta;
}

const { title, description, image, imageAlt, path, noIndex, article } =
	Astro.props;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" href="/favicon.ico" />
<link rel="sitemap" href="/sitemap-index.xml" />
<script is:inline>
  (() => {
    try {
      const savedTheme = localStorage.getItem("theme");
      const systemPrefersDark = window.matchMedia(
        "(prefers-color-scheme: dark)",
      ).matches;
      const theme =
        savedTheme === "dark" || savedTheme === "light"
          ? savedTheme
          : systemPrefersDark
            ? "dark"
            : "light";
      document.documentElement.classList.toggle("dark", theme === "dark");
    } catch {
      /* noop */
    }
  })();
</script>
<link
  rel="alternate"
  type="application/rss+xml"
  title={SITE_TITLE}
  href={new URL("rss.xml", Astro.site || Astro.url.origin)}
/>
<meta name="generator" content={Astro.generator} />

<!-- Font preloads -->
<link
  rel="preload"
  href="/fonts/MPLUS1Code-VariableFont_wght.ttf"
  as="font"
  type="font/ttf"
  crossorigin
/>

<!-- SEO Meta Tags（canonical / OGP / X カード / JSON-LD） -->
<SEO
	title={title}
	description={description}
	ogImage={image}
	ogImageAlt={imageAlt}
	path={path}
	noIndex={noIndex}
	article={article}
/>
