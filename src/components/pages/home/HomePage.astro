---
import type { Blog } from "@/types/blog";
import HeroSection from "./HeroSection.astro";
import LinksSection from "./LinksSection.astro";
import RecentBlogsSection from "./RecentBlogsSection.astro";

interface LinkItem {
	service: string;
	url: string;
	icon: string | null;
	name: string;
}

interface Props {
	latestBlogs: Blog[];
	links: LinkItem[];
}

const { latestBlogs, links } = Astro.props;
---

<HeroSection />
<div class="two">
  <LinksSection links={links} />
  <RecentBlogsSection blogs={latestBlogs} />
</div>

<style>
  .two {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr);
    gap: 16px;
    align-items: start;
  }

  /* 左のコマンド窓（200px）がある間はリンクの窓が狭くなるため、早めに 1 カラムにする */
  @media (max-width: 1000px) {
    .two {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
