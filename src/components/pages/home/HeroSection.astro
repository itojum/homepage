---
import { Image } from "astro:assets";
import iconImage from "@/assets/icon.jpg";

const intro =
	'Web系のプロダクトエンジニアやってます。Web技術、AIエージェント、Minecraftなどに興味があります。名前は"いとじゅん"と読んでほしいです。';
---

<section class="win msg" aria-labelledby="hero-name">
  <Image
    src={iconImage}
    class="face"
    alt="いとじゅんのアイコン"
    width={336}
    height={336}
    loading="eager"
  />
  <div class="body">
    <h1 id="hero-name" class="speaker">
      いとじゅん<small>itojum ／ product engineer / junior developer</small>
    </h1>
    <p class="say">{intro}</p>
    <p class="go">
      <a href="/about">プロフィールを見る</a><span class="next" aria-hidden="true">▼</span>
    </p>
  </div>
</section>

<style>
  .msg {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 22px;
    align-items: start;
    --win-pad: 24px 26px 26px;
  }

  .face {
    display: block;
    width: 168px;
    height: 168px;
    object-fit: cover;
    background: var(--win-2);
    box-shadow: 0 0 0 3px var(--edge);
  }

  .speaker {
    margin: 0 0 4px;
    font-family: var(--font-dot);
    font-size: 20px;
    font-weight: 400;
    line-height: 1.4;
  }

  .speaker small {
    margin-left: 10px;
    font-size: 14px;
    color: var(--ink-2);
  }

  .say {
    font-size: 16px;
    line-height: 2;
  }

  .go {
    margin-top: 12px;
    font-family: var(--font-dot);
    font-size: 15px;
  }

  .next {
    display: inline-block;
    margin-left: 4px;
    font-size: 12px;
    color: var(--cursor);
  }

  @media (max-width: 760px) {
    .msg {
      grid-template-columns: minmax(0, 1fr);
    }

    .face {
      width: 112px;
      height: 112px;
    }

    .speaker small {
      display: block;
      margin-left: 0;
    }
  }
</style>
