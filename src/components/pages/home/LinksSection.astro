---
import SpecialThanks from "./SpecialThanks.astro";

interface LinkItem {
	service: string;
	url: string;
	icon: string | null;
	name: string;
}

interface Props {
	links: LinkItem[];
}

const { links } = Astro.props;
---

<section class="win" aria-labelledby="links-title">
  <h2 id="links-title" class="win-title">リンク</h2>
  <ul class="links">
    {links.map((link) => (
      <li>
        <a class="cursor-row row" href={link.url} target="_blank" rel="noopener noreferrer">
          <span class="svc dot-label">{link.service}</span>
          <span>{link.name}</span>
        </a>
      </li>
    ))}
  </ul>
  <SpecialThanks />
</section>

<style>
  .links {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .row {
    display: grid;
    grid-template-columns: 7.5em minmax(0, 1fr);
    font-size: 14px;
  }

  .svc {
    color: var(--ink-2);
  }
</style>
