---
import FormattedDate from "@/components/ui/FormattedDate.astro";
import type { Slide } from "@/types/slide";

interface Props {
	slide: Slide;
}

const { slide } = Astro.props;
---

<li>
  <a href={slide.url} class="card" target="_blank" rel="noopener noreferrer">
    <span class="thumb">
      {slide.thumbnailUrl && <img src={slide.thumbnailUrl} alt="" loading="lazy" decoding="async" />}
    </span>
    {slide.publishedAt && (
      <span class="date dot-label"><FormattedDate date={slide.publishedAt} /></span>
    )}
    <span class="title">{slide.title}</span>
  </a>
</li>

<style>
  .card {
    display: grid;
    gap: 4px;
    padding: 8px;
    color: var(--ink);
    border-bottom: 0;
  }

  .card:hover {
    background: var(--win-2);
  }

  .card:hover .title {
    color: var(--link);
  }

  .thumb {
    display: block;
    aspect-ratio: 16 / 9;
    max-width: 100%;
    overflow: hidden;
    margin-bottom: 6px;
    background: var(--win-2);
    box-shadow: 0 0 0 2px var(--edge);
  }

  .thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .date {
    font-size: 13px;
    color: var(--ink-2);
  }

  .title {
    font-weight: 500;
    line-height: 1.6;
  }
</style>
