---
import type { Eyecatch } from "@/types/blog";

interface Props {
	eyecatch: Eyecatch | null;
}

const { eyecatch } = Astro.props;
---

{eyecatch?.url && (
  <div class="thumbnail">
    <img src={eyecatch.url} alt="" data-pagefind-meta="image[src]" />
  </div>
)}

<style>
  .thumbnail {
    margin-top: 18px;
    aspect-ratio: 16 / 9;
    max-width: 100%;
    overflow: hidden;
    background: var(--win-2);
    box-shadow: 0 0 0 3px var(--edge);
  }

  .thumbnail img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
