---
import FormattedDate from "@/components/ui/FormattedDate.astro";
import type { Blog } from "@/types/blog";

interface Props {
	blog: Blog;
}

const { blog } = Astro.props;
---

<header class="head">
  <p class="dates dot-label">
    <span data-pagefind-meta="date"><FormattedDate date={blog.publishedAt} /></span>
    {blog.updatedAt && <span class="revised">更新 <FormattedDate date={blog.updatedAt} /></span>}
  </p>
  <h1 class="title" data-pagefind-meta="title">{blog.title}</h1>
  {blog.description && (
    <p class="lead" data-pagefind-meta="description">{blog.description}</p>
  )}
  {(blog.category || blog.tags.length > 0) && (
    <p class="tags">
      {blog.category && <span data-pagefind-filter="category">{blog.category}</span>}
      {blog.tags.map((tag) => <span data-pagefind-filter="tag">{tag}</span>)}
    </p>
  )}
</header>

<style>
  .dates {
    display: flex;
    flex-wrap: wrap;
    gap: 0 14px;
    margin-bottom: 6px;
    font-size: 14px;
    color: var(--ink-2);
  }

  .title {
    margin-bottom: 8px;
    font-size: clamp(22px, 3.2vw, 30px);
    line-height: 1.45;
    text-wrap: balance;
  }

  .lead {
    margin-bottom: 8px;
    font-size: 14.5px;
    color: var(--ink-2);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    font-size: 13px;
    color: var(--ink-2);
  }

  .tags span + span::before {
    content: "／";
    margin: 0 0.5em;
  }
</style>
