---
import BlogBody from "@/components/pages/blog/BlogBody.astro";
import BlogMeta from "@/components/pages/blog/BlogMeta.astro";
import BlogShare from "@/components/pages/blog/BlogShare.astro";
import BlogThumbnail from "@/components/pages/blog/BlogThumbnail.astro";
import RelatedBlogSection from "@/components/pages/blog/RelatedBlogSection.astro";
import { SITE_TITLE } from "@/consts";
import type { Blog } from "@/types/blog";

interface Props {
	blog: Blog;
	relatedBlogs: Blog[];
}

const { blog, relatedBlogs } = Astro.props;
---

<article class="win" data-pagefind-body>
  <BlogMeta blog={blog} />
  <BlogThumbnail eyecatch={blog.eyecatch} />
  <BlogBody>
    <slot />
  </BlogBody>
</article>

<div class="win share-win">
  <BlogShare title={`${blog.title} | ${SITE_TITLE}`} />
  <a href="/blogs/" class="back dot-label">◀ 一覧へ戻る</a>
</div>

<RelatedBlogSection relatedBlogs={relatedBlogs} />

<style>
  .share-win {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 22px;
    --win-pad: 16px 24px;
  }

  .back {
    margin-left: auto;
    font-size: 15px;
  }
</style>
