---
import BlogListItem from "@/components/pages/blogs/BlogListItem.astro";
import type { Blog } from "@/types/blog";

interface Props {
	relatedBlogs: Blog[];
}

const { relatedBlogs } = Astro.props;
---

{relatedBlogs.length > 0 && (
  <section class="win" aria-labelledby="related-title">
    <h2 id="related-title" class="win-title">関連する記事</h2>
    <ul class="list">
      {relatedBlogs.map((blog) => <BlogListItem blog={blog} />)}
    </ul>
  </section>
)}

<style>
  .list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>
