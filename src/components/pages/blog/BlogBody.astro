---

<div class="post"><slot /></div>

<style>
  .post {
    max-width: 38em;
    margin: 0 auto;
    padding: 14px 8px 4px;
    font-size: 16px;
    line-height: 2.05;
  }
  .post :global(h2) {
    margin: 2.4em 0 0.6em;
    padding-bottom: 6px;
    font-size: 21px;
    line-height: 1.5;
    border-bottom: 3px double var(--main);
  }
  .post :global(h3) {
    margin: 2em 0 0.4em;
    font-size: 17px;
  }
  .post :global(h3)::before {
    content: "▶ ";
    font-size: 0.8em;
    color: var(--cursor);
  }
  .post :global(h4) {
    margin: 1.6em 0 0.4em;
    font-size: 16px;
  }
  .post :global(p) {
    margin: 0 0 1.2em;
  }
  .post :global(ul),
  .post :global(ol) {
    margin: 0 0 1.2em;
    padding-left: 1.4em;
  }
  .post :global(ul) {
    list-style: none;
  }
  .post :global(ul > li)::before {
    content: "・";
    margin-left: -1em;
    color: var(--main);
  }
  .post :global(ol) {
    list-style: decimal;
  }
  .post :global(li) {
    margin: 0.2em 0;
  }
  .post :global(img) {
    display: block;
    margin: 1.4em 0 0.6em;
    box-shadow: 0 0 0 3px var(--edge);
  }
  .post :global(figure) {
    margin: 1.8em 0;
  }
  .post :global(figcaption) {
    font-size: 13px;
    color: var(--ink-2);
  }
  .post :global(blockquote) {
    margin: 1.6em 0;
    padding: 4px 0 4px 18px;
    border-left: 4px solid var(--main);
    color: var(--ink-2);
  }
  .post :global(blockquote p:last-child) {
    margin-bottom: 0;
  }
  .post :global(table) {
    display: block;
    max-width: 100%;
    overflow-x: auto;
    margin: 0 0 1.2em;
    border-collapse: collapse;
    font-size: 14px;
  }
  .post :global(th),
  .post :global(td) {
    padding: 6px 10px;
    border: 1px solid var(--ink-2);
  }
  .post :global(th) {
    background: var(--win-2);
  }
  .post :global(.twitter-tweet) {
    margin: 1.5em auto;
  }

  /* スライド・動画の iframe 埋め込み（aspect-ratio は要素ごとに指定） */
  .post :global(.embed) {
    position: relative;
    width: 100%;
    margin: 1.5em 0;
  }
  .post :global(.embed iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  /* リンクカード */
  .post :global(.link-card) {
    display: flex;
    margin: 1.5em 0;
    overflow: hidden;
    border: 2px solid var(--edge);
    color: inherit;
    text-decoration: none;
    transition: background-color 0.2s;
  }
  .post :global(a.link-card:hover) {
    border-bottom-width: 2px;
  }
  .post :global(.link-card:hover) {
    background-color: var(--win-2);
  }
  .post :global(.link-card__body) {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.25em;
    min-width: 0;
    padding: 0.85em 1em;
  }
  .post :global(.link-card__title) {
    overflow: hidden;
    color: var(--ink);
    font-weight: 600;
    line-height: 1.4;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .post :global(.link-card__description) {
    display: -webkit-box;
    overflow: hidden;
    color: var(--ink-2);
    font-size: 0.85em;
    line-height: 1.5;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }
  .post :global(.link-card__site) {
    margin-top: auto;
    color: var(--ink-2);
    font-size: 0.8em;
  }
  .post :global(.link-card__image) {
    flex-shrink: 0;
    width: 30%;
    max-width: 220px;
    margin: 0;
    object-fit: cover;
    border-radius: 0;
    box-shadow: none;
  }
  @media (max-width: 560px) {
    .post :global(.link-card__description) {
      display: none;
    }
  }

  @media (max-width: 760px) {
    .post {
      padding: 14px 0 0;
      font-size: 15.5px;
    }
  }
</style>
