---
interface Props {
	title: string;
	description: string;
}

const { title, description } = Astro.props;
---

<h1 class="title" data-pagefind-meta="title">{title}</h1>
<p class="summary" data-pagefind-meta="description">
  {description}
</p>
<div class="post"><slot /></div>

<style>
  .title {
    padding-bottom: 0.5em;
    line-height: 1.2;
    color: rgb(var(--black));
    font-size: 3rem;
  }
  .summary {
    margin: 0.5em 0;
    font-size: 1rem;
    color: rgb(var(--gray));
  }
  .post {
    line-height: 1.7;
  }
  .post :global(h2) {
    margin: 1.5em 0 0.5em;
    font-size: 2rem;
  }
  .post :global(h3) {
    margin: 1.25em 0 0.5em;
    font-size: 1.5rem;
  }
  .post :global(p) {
    margin: 0.75em 0;
  }
  .post :global(ul),
  .post :global(ol) {
    margin: 0.75em 0;
    padding-left: 1.5em;
  }
  .post :global(ul) {
    list-style: disc;
  }
  .post :global(ol) {
    list-style: decimal;
  }
  .post :global(li) {
    margin: 0.25em 0;
  }
  .post :global(a) {
    color: var(--accent);
    text-decoration: underline;
  }
  .post :global(img) {
    @apply rounded-md shadow-md;
    margin: 0.75em 0;
  }
  .post :global(figcaption) {
    font-size: 0.8em;
    color: rgb(var(--gray));
  }
  .post :global(blockquote) {
    color: rgb(var(--gray));
    font-size: 0.9em;
  }
  .post :global(.twitter-tweet) {
    margin: 1.5em auto;
  }

  /* スライド・動画の iframe 埋め込み（aspect-ratio は要素ごとに指定） */
  .post :global(.embed) {
    position: relative;
    width: 100%;
    margin: 1.5em 0;
  }
  .post :global(.embed iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    border-radius: 8px;
  }

  /* リンクカード */
  .post :global(.link-card) {
    display: flex;
    margin: 1.5em 0;
    overflow: hidden;
    border: 1px solid rgba(var(--border), 90%);
    border-radius: 8px;
    color: inherit;
    text-decoration: none;
    transition: background-color 0.2s;
  }
  .post :global(.link-card:hover) {
    background-color: rgba(var(--border), 25%);
  }
  .post :global(.link-card__body) {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.25em;
    min-width: 0;
    padding: 0.85em 1em;
  }
  .post :global(.link-card__title) {
    overflow: hidden;
    color: rgb(var(--black));
    font-weight: 600;
    line-height: 1.4;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .post :global(.link-card__description) {
    display: -webkit-box;
    overflow: hidden;
    color: rgb(var(--gray));
    font-size: 0.85em;
    line-height: 1.5;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }
  .post :global(.link-card__site) {
    margin-top: auto;
    color: rgb(var(--gray));
    font-size: 0.8em;
  }
  .post :global(.link-card__image) {
    flex-shrink: 0;
    width: 30%;
    max-width: 220px;
    margin: 0;
    object-fit: cover;
    border-radius: 0;
    box-shadow: none;
  }
  @media (max-width: 560px) {
    .post :global(.link-card__description) {
      display: none;
    }
  }
</style>
