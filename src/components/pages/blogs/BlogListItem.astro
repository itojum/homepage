---
import FormattedDate from "@/components/ui/FormattedDate.astro";
import type { Blog } from "@/types/blog";

interface Props {
	blog: Blog;
	/** 指定するとサムネイルと通し番号（No.08 など）付きの行になる */
	number?: number;
}

const { blog, number } = Astro.props;
const withThumb = number !== undefined;
const isExternal = blog.source !== "blog";
---

<li>
  <a
    href={blog.url}
    class:list={["cursor-row", "item", { "item--thumb": withThumb }]}
    {...(isExternal && { target: "_blank", rel: "noopener" })}
  >
    {withThumb && (
      <span class="thumb">
        {blog.eyecatch?.url && <img src={blog.eyecatch.url} alt="" loading="lazy" decoding="async" />}
      </span>
    )}
    <span class="txt">
      <span class="date dot-label">
        {withThumb && <span class="no">No.{String(number).padStart(2, "0")}</span>}
        <FormattedDate date={blog.publishedAt} />
      </span>
      <span class="title">
        {blog.source === "qiita" && <span class="src">Qiita</span>}
        {blog.title}
        {isExternal && <span class="sr-only">（新しいタブで開く）</span>}
      </span>
      {blog.tags.length > 0 && <span class="tags">{blog.tags.join(" ／ ")}</span>}
    </span>
  </a>
</li>

<style>
  .txt {
    display: grid;
    grid-template-columns: 6.8em minmax(0, 1fr);
    gap: 0 12px;
    min-width: 0;
  }

  .date {
    font-size: 14px;
    color: var(--ink-2);
  }

  .title {
    font-weight: 500;
    line-height: 1.6;
  }

  .tags {
    grid-column: 2;
    font-size: 12px;
    color: var(--ink-2);
  }

  /* サムネイル付き（ブログ一覧） */
  .item--thumb {
    display: grid;
    grid-template-columns: 176px minmax(0, 1fr);
    gap: 0 18px;
    align-items: center;
    padding-block: 12px;
    border-bottom: 1px solid var(--win-2);
  }

  .item--thumb .txt {
    grid-template-columns: minmax(0, 1fr);
    gap: 2px;
  }

  .item--thumb .tags {
    grid-column: auto;
  }

  .item--thumb .title {
    font-size: 16px;
  }

  .src {
    margin-right: 2px;
    padding: 0 5px;
    vertical-align: 0.1em;
    font-size: 11px;
    color: #fff;
    background: #55c500;
  }

  .no {
    margin-right: 12px;
    color: var(--link);
  }

  .thumb {
    display: block;
    aspect-ratio: 16 / 9;
    max-width: 100%;
    overflow: hidden;
    background: var(--win-2);
    box-shadow: 0 0 0 2px var(--edge);
  }

  .thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 760px) {
    .txt {
      grid-template-columns: minmax(0, 1fr);
    }

    .tags {
      grid-column: auto;
    }

    .item--thumb {
      grid-template-columns: 112px minmax(0, 1fr);
      gap: 0 12px;
      padding: 10px 4px;
    }

    .item--thumb::before {
      display: none;
    }

    .item--thumb .title {
      font-size: 14.5px;
      line-height: 1.55;
    }
  }
</style>
