---
import FormattedDate from "@/components/ui/FormattedDate.astro";
import type { Blog } from "@/types/blog";

interface Props {
	blog: Blog;
}

const { blog } = Astro.props;
const publishedDate = blog.publishedAt;
---

<li class="card">
  <a href={`/blogs/${blog.id}/`} class="card-link">
    <div class="card-image-wrap">
      {blog.eyecatch?.url ? (
        <img src={blog.eyecatch.url} alt="" loading="lazy" />
      ) : (
        <div class="card-image-placeholder" aria-hidden="true">
          📝
        </div>
      )}
    </div>
    <div class="card-body">
      <div class="card-meta">
        <time class="card-date">
          <FormattedDate date={publishedDate} />
        </time>
      </div>
      <h2 class="card-title">{blog.title}</h2>
      <p class="card-description" data-pagefind-meta="description">
        {blog.description}
      </p>
      {(blog.category || blog.tags.length > 0) && (
        <div class="card-taxonomies">
          {blog.category && (
            <span class="card-category">{blog.category}</span>
          )}
          {blog.tags.length > 0 && (
            <ul class="card-tags" aria-label="タグ">
              {blog.tags.map((tag) => (
                <li><span>{tag}</span></li>
              ))}
            </ul>
          )}
        </div>
      )}
    </div>
  </a>
</li>
